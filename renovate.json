{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "reviewers": ["fathonyfath"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "s2tool: version and SHA-256 ARG lines under a '# renovate:' comment",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\w+=(?<currentValue>\\S+)\\s+ARG \\w+_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ]
    }
  ]
}
